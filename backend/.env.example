# ============================================================
# SMART PILLBOX — Cấu hình môi trường
# Sao chép file này thành .env và điền giá trị thực tế
# cp .env.example .env
# ============================================================

# ── Ứng dụng ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── Cơ sở dữ liệu SQLite ──────────────────────────────────
DB_PATH=pillbox.db

# ── MQTT Broker ───────────────────────────────────────────
# Cài Mosquitto: https://mosquitto.org/download/
# Chạy local: mosquitto -v
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smartpillbox-backend

# ── ESP32 Thiết bị ────────────────────────────────────────
DEVICE_ID=ESP32_PILLBOX_01
TOTAL_SLOTS=8

# ── Watchdog An toàn ──────────────────────────────────────
# Thời gian tối đa (giây) chờ lấy thuốc trước khi tự về Slot 0
DISPENSE_TIMEOUT_SECONDS=900
